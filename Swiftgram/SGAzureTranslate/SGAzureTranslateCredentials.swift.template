import Foundation

// MARK: Swiftgram
//
// Build-time credentials for the Azure AI Translator backend.
//
// Copy this file to Sources/SGAzureTranslateCredentials.swift and fill it in.
// The real file is gitignored so keys never reach history; the module will not
// compile without it, since the BUILD glob expects it under Sources/.
//
//     cp Swiftgram/SGAzureTranslate/SGAzureTranslateCredentials.swift.template \
//        Swiftgram/SGAzureTranslate/Sources/SGAzureTranslateCredentials.swift
//
// An empty `key` is a valid, safe state: the Azure backend is then hidden from
// the translation-service picker and never selected, so the app still builds and
// runs with the other backends.
//
// - `key`:      a subscription key from the Translator resource
//               (Azure portal -> your Translator resource -> Keys and Endpoint).
// - `region`:   the resource location, e.g. "westeurope", "eastus", "global".
//               Required for regional and multi-service resources.
// - `endpoint`: the global endpoint below is correct for almost every resource.
//               Use a custom subdomain only if your resource has one, in the form
//               "https://<resource-name>.cognitiveservices.azure.com".
// - `category`: Custom Translator category id, or "" for the general model.

public enum SGAzureTranslateCredentials {
    public static let key: String = ""
    public static let region: String = ""
    public static let endpoint: String = "https://api.cognitive.microsofttranslator.com"
    public static let category: String = ""
}
