import Foundation

// MARK: Swiftgram
//
// Build-time credentials for the OpenAI translation backend.
//
// Copy this file to Sources/SGOpenAITranslateCredentials.swift and fill it in.
// The real file is gitignored so keys never reach history; the module will not
// compile without it, since the BUILD glob expects it under Sources/.
//
//     cp Swiftgram/SGOpenAITranslate/SGOpenAITranslateCredentials.swift.template \
//        Swiftgram/SGOpenAITranslate/Sources/SGOpenAITranslateCredentials.swift
//
// An empty `key` is a valid, safe state: the OpenAI backend is then hidden from
// the translation-service picker and skipped in the comparison screen.
//
// - `key`:      an OpenAI API key (platform.openai.com -> API keys).
// - `model`:    the model id, sent to the chat-completions endpoint.
//
//               Verified 2026-08-18: the gpt-realtime-* models do NOT work here.
//               `gpt-realtime-2` returns 404 "This is not a chat model" from
//               v1/chat/completions and 400 "model not found" from v1/responses,
//               despite its model page listing both endpoints. They are reachable
//               only over the realtime protocol (WebSocket/WebRTC/SIP), which
//               this backend does not speak. `gpt-realtime-translate` is
//               audio-in/audio-out only and cannot translate text at all.
//
//               Measured on the same phrase, all correct: gpt-5.1 1.09s,
//               gpt-4.1-mini 1.10s (cheaper), gpt-5-mini 2.44s.
// - `endpoint`: the chat-completions URL. Swap for a compatible proxy if needed.
// - `systemPrompt`: `%@` is replaced with the target language code.

public enum SGOpenAITranslateCredentials {
    public static let key: String = ""
    public static let model: String = "gpt-5.1"
    public static let endpoint: String = "https://api.openai.com/v1/chat/completions"
    public static let systemPrompt: String = "You are a translation engine. Translate the user's message into the language with code \"%@\". Reply with the translation and nothing else: no quotes, no notes, no explanation, no romanisation. Preserve the original line breaks, emoji, @mentions, #hashtags, URLs and code spans exactly. If the message is already in the target language, repeat it unchanged."
}
